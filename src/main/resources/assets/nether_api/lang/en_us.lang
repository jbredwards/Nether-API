config.nether_api.vanilla.advanced.fixEnderTeleportation=Fix Ender Teleportation
config.nether_api.vanilla.advanced.fixEnderTeleportation.tooltip=Fix Vanilla ender teleportation bugs:\n- Prevent client-only teleportation. Fixes janky teleporting when fighting endermen or shulkers (for example).\n- Prevent dead entity teleportation. Fixes annoying situations where enderman loot will be somewhere else.
config.nether_api.vanilla.advanced.fortressMaxY=Nether Fortress (Y Max)
